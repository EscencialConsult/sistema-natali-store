# Copiá este archivo como .env.local (git lo ignora) y completá con los datos de TU proyecto de Supabase
# (Project Settings -> API Keys). Sin estas dos variables la app muestra "falta configurar el servidor".
# Solo la clave PÚBLICA (publishable / anon): NUNCA pongas la clave secreta (secret / service_role) en la app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
